# Normalise text files to LF in the repository; Git picks the working-copy ending.
* text=auto

# Shell scripts must stay LF even on Windows, or Linux and Docker fail on "/bin/sh^M".
mvnw text eol=lf
*.sh text eol=lf

# Windows batch files need CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf

# Vendored third-party files are kept byte for byte: frontend/index.html checks
# Chart.js against a SHA-384 hash, and a line-ending conversion on checkout would
# change the bytes, fail that check, and silently leave every chart blank.
frontend/vendor/** -text

# Binary
*.png binary
*.jpg binary
*.jar binary
